SQLITE_PATH=.local/places.db
CHROMA_PATH=data/cache/chroma
AZURE_AI_ENDPOINT=https://<your-endpoint>.swedencentral.inference.ai.azure.com
AZURE_AI_API_KEY=<your-key>
AZURE_AI_MODEL=<your-model>
AZURE_EMBEDDING_MODEL=<your-embedding-model>
AZURE_COHERE_RERANK_ENDPOINT=https://<your-cohere-endpoint>/v2/rerank
AZURE_COHERE_RERANK_API_KEY=<your-cohere-deployment-key>
# Optional; defaults to Cohere-rerank-v4.0-pro
AZURE_COHERE_RERANK_MODEL=Cohere-rerank-v4.0-pro
